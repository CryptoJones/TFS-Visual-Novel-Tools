; Engine configuration file.
; TFS Visual Novel Engine — demo project.
;
; To rebrand: change config/name below, the accent color in src/ui/UITheme.gd,
; and the export binary names + bundle id in export_presets.cfg. Open in Godot 4.x.

config_version=5

[application]

config/name="TFS Visual Novel Engine — Demo"
config/version="0.3.0"
config/description="A point-and-click adventure / visual novel built on the TFS Visual Novel engine. Replace data/ and assets/ with your own content."
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://src/core/GameState.gd"
Assets="*res://src/core/Assets.gd"
AudioManager="*res://src/core/AudioManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
